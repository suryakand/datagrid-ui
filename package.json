{
  "name": "@helix-x/datagrid-ui",
  "version": "0.1.2",
  "description": "Dependency-free React data grid: virtualized rows, server-side paging/sorting/filtering, inline editing, Tailwind-styled",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "clean": "rm -rf dist docs",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "react",
    "datagrid",
    "data-grid",
    "table",
    "virtualized",
    "server-side",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryakand/datagrid-ui.git"
  },
  "homepage": "https://suryakand.github.io/datagrid-ui/",
  "bugs": {
    "url": "https://github.com/suryakand/datagrid-ui/issues"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.20",
    "typescript": "~5.7.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "publishConfig": {
    "access": "public"
  }
}
